# Copy to .env and edit before first run.

# Path to this user's frozen Zomboid install.
FROZEN_ROOT=C:\Users\<you>\ZomboidFrozen

# Path to this repo on disk.
REPO_ROOT=C:\Users\<you>\Desktop\ClaudeHQ\workspace\zomboid-mods

# SSH target for the dedicated server (leave blank if you don't deploy).
SERVER_SSH=sculky@192.168.1.220

# Optional overrides
# REPO=A-Su11y/zomboid-mods
# LAN_DASHBOARD_URL=http://192.168.1.220:8086
# MODS_DIR=  # defaults to <FROZEN_ROOT>\userprofile\mods
