# Local-only, do NOT commit. Copy to .env next to update-server-mods.sh
# on the server, chmod 600.

# Absolute path to your Project Zomboid dedicated server's mods directory
# (the one SELF_MANAGED_MODS points at).
MODS_DIR=/path/to/your/pz-server/mods

# GitHub repo for the patches. Only change if you forked.
REPO=A-Su11y/zomboid-mods
